# Copy to .env.local and fill in. Never commit real values.

# --- Public (shipped to the browser; safe by design) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (Python functions) ---
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=
# Transaction pooler, port 6543. URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
GEMINI_API_KEY=
DISCORD_WEBHOOK_URL=

# Optional
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Tried in order when the chat model is rate-limited or unavailable. Empty disables fallback.
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-2.5-flash

# Only for scripts/seed.py (demo account)
DEMO_EMAIL=reviewer@example.com
DEMO_PASSWORD=
